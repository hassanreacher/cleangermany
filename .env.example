# ---------- Supabase (browser) ----------
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...            # Project Settings → API → anon public

# ---------- Supabase (server, only on Vercel – never in the browser) ----------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...         # Project Settings → API → service_role

# ---------- Your own SMTP for order / assignment / review e-mails (api/notify.ts) ----------
SMTP_HOST=mail.gmx.net
SMTP_PORT=465                            # 465 = SSL/TLS (GMX), 587 = STARTTLS (automatischer Fallback)
SMTP_USER=Glanzgeschwister@gmx.de        # muss identisch mit der Absenderadresse sein
SMTP_PASS=your_smtp_password             # GMX: "Zugriff über externe Programme" muss aktiviert sein
SMTP_FROM=Glanzgeschwister Team          # nur der Anzeigename; die Adresse kommt aus SMTP_USER
ADMIN_EMAIL=Moh.a.sharekh@gmail.com, Glanzgeschwister@gmx.de   # Aktivitäts-Mails (mehrere Adressen mit Komma)
SITE_URL=https://cleangermany.vercel.app

# ---------- Groq (AI assistant "Clea") ----------
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile
